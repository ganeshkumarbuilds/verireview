# VeriReview — environment template (Phase 0)
# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.

# PostgreSQL (Compose db service)
POSTGRES_DB=verireview
POSTGRES_USER=verireview
POSTGRES_PASSWORD=change-me-in-your-local-env

# Spring Boot backend (local `.\mvnw.cmd spring-boot:run` from backend/ reads this
# file automatically; containerized use overrides the URL with the db hostname)
# JWT_SIGNING_KEY must be set from Phase 3 onward (min 256-bit, env only)
JWT_SIGNING_KEY=
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/verireview
SPRING_DATASOURCE_USERNAME=verireview
SPRING_DATASOURCE_PASSWORD=change-me-in-your-local-env

# AI service (Phase 7+; local ai-service on :8001, service-to-service secret)
OPENROUTER_API_KEY=
AI_SERVICE_INTERNAL_URL=http://localhost:8001
AI_SERVICE_INTERNAL_SECRET=
BACKEND_INTERNAL_URL=http://backend:8080

# Sandbox (Phase 10+; limits frozen in ADR-007, values here for runtime override)
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_COUNT=1
SANDBOX_MAX_OUTPUT_MB=5
SANDBOX_MAX_PROJECT_MB=50
SANDBOX_MAX_FILES=2000
