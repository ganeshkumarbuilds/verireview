# VeriReview .gitignore — Phase 0

# Secrets / env
.env
.env.local
*.pem
*.key

# Local-only compose overrides (machine-specific ports/secrets)
docker-compose.override.yml

# Java / Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# Spring Boot
spring-shell.log

# Frontend / Node
node_modules/
dist/
build/
.vite/
*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases / volumes
pgdata/
*.sqlite
*.db

# Uploads / sandbox workspaces (never commit)
uploads/
workspaces/
quarantine/
sandbox-work/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.log
